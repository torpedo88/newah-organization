# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.
# These same values go into Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# PUBLIC — shipped to the browser in the JS bundle.
# Not secret. Anyone can read these from the deployed site.
# Their safety depends entirely on Row Level Security being correct.
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Never prefix with NEXT_PUBLIC_.
# Read by lib/actions/register.ts to send confirmation emails.
# Resend Dashboard → API Keys
RESEND_API_KEY=

# Who confirmation emails come from, e.g. "Newah Organization <noreply@example.org>".
# MUST be an address on a domain verified in Resend. Left unset, the code falls
# back to Resend's shared test domain, which only delivers to the Resend account
# holder — registrants get nothing.
RESEND_FROM=

# SECRET — server-only. Never prefix with NEXT_PUBLIC_.
# Shared password for /admin, which lists registrant names, phone
# numbers and email addresses. Use a long random value, and change
# it when someone leaves the board — changing it also invalidates
# every session issued under the old one.
ADMIN_PASSWORD=

# SECRET — server-only. Never prefix with NEXT_PUBLIC_.
# Bypasses Row Level Security completely. Treat as root on the database.
#
# This file previously said this key must never reach Vercel, on the
# grounds that the application never needed it. /admin changed that:
# the registrations table deliberately has no SELECT policy, because the
# anon key ships to every browser, so the board cannot read the table as
# anon and there is no Supabase identity to attach a policy to while the
# admin uses a shared password. The service role is therefore the only
# way to read it.
#
# It is imported only through lib/supabase/admin.ts, which begins with
# `import "server-only"` — a build error if it is ever pulled into a
# client bundle. Set it in Vercel as a server-side variable only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (donations) ---------------------------------------------------
# Secret key. Stripe exposes this only in the Dashboard (Developers -> API
# keys); it is not retrievable through the API, the CLI or OAuth. Without it
# donations are recorded as pending and no card is ever charged.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint that marks a donation paid. Comes
# from the endpoint you create at Developers -> Webhooks, or from
# `stripe listen` when running locally. The webhook is the ONLY thing that may
# mark a donation paid, so without this no payment is ever recorded.
STRIPE_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------------
# Canonical origin, used for metadataBase, og:url and the Stripe return URLs.
# Falls back to the Vercel-provided host, then to the production URL. Must be a
# full origin including the scheme. Do NOT mark this Sensitive in Vercel:
# `vercel env pull` then returns the literal "[SENSITIVE]", which is not a URL.
NEXT_PUBLIC_SITE_URL=
