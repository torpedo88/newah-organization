# Supabase project URL — Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key — safe for the browser, subject to RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service role key here on purpose. It bypasses Row Level Security and has
# no reader in this codebase yet. It gets added, server-side only, in the phase
# that actually needs it.
