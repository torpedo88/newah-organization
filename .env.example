# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.
# These same values go into Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# PUBLIC — shipped to the browser in the JS bundle.
# Not secret. Anyone can read these from the deployed site.
# Their safety depends entirely on Row Level Security being correct.
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Never prefix with NEXT_PUBLIC_.
# Read by lib/actions/register.ts to send confirmation emails.
# Resend Dashboard → API Keys
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# NOT here on purpose: SUPABASE_SERVICE_ROLE_KEY.
# It bypasses Row Level Security entirely. The application never
# needs it. Only run-migration.sh uses it, and only as a shell
# variable you export for that one command — never in this file,
# never in Vercel, never in the browser.
# ─────────────────────────────────────────────────────────────
